type Query {
  _dummy: String
}

type Mutation {
  registerUser(input: RegistrationInput!): User!
}

input RegistrationInput {
  issuer: String!
  subject: String!
  email: String!
  emailVerified: Boolean!
}

type User implements Identifiable {
  id: ID!
}
